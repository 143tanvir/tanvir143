{
  "name": "tanvir143",
  "version": "1.0.0",
  "description": "Bot-first Instagram Chat API with MQTT realtime messaging, session persistence, media, thread management, and InstaBot/FCA-compatible APIs.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "test/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "syntax": "node --check index.js && find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "pack:check": "npm pack --dry-run --json"
  },
  "keywords": [
    "instagram",
    "instagram-api",
    "instagram-chat-api",
    "instagram-bot",
    "instagram-direct",
    "chatbot",
    "ica",
    "fca",
    "fca-compatible",
    "mqtt",
    "realtime",
    "session",
    "tanvir143"
  ],
  "author": "Tanvir Ahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/143tanvir/insta-robot-143.git"
  },
  "bugs": {
    "url": "https://github.com/143tanvir/insta-robot-143/issues"
  },
  "homepage": "https://github.com/143tanvir/insta-robot-143#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^5.0.5",
    "duplexify": "^4.1.3",
    "https-proxy-agent": "^7.0.6",
    "mqtt": "^4.3.8",
    "node-cron": "^3.0.3",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "totp-generator": "^2.0.1",
    "tough-cookie": "^5.1.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  }
}
